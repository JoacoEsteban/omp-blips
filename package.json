{
  "name": "omp-blips",
  "version": "0.3.1",
  "files": [
    "src",
    "!src/**/*.test.ts",
    "blips.example.json"
  ],
  "type": "module",
  "description": "omp extension that plays a pitched blip while the assistant streams text",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JoacoEsteban/omp-blips.git"
  },
  "omp": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts",
    "lint:fix": "eslint src scripts --fix",
    "postversion": "jj bookmark set main -r v$npm_package_version && jj git push -b main --tag v$npm_package_version"
  },
  "dependencies": {
    "esfuzz": "^0.3.1",
    "lorem-ipsum": "^3.0.0",
    "rxjs": "^7.8.2",
    "ts-pattern": "^5.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@oh-my-pi/pi-coding-agent": "^18.2.8",
    "@types/bun": "^1.4.2",
    "better-typescript-lib": "^2.12.0",
    "eslint": "^10.2.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.16.1",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.0"
  }
}
